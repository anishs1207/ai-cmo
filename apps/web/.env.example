# Neon Postgres (https://neon.tech → your project → Connect)
DATABASE_URL=

# Neon Auth (Neon Console → Auth → Enable Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Composio (https://app.composio.dev -> Settings -> API Keys)
COMPOSIO_API_KEY=

# One app-owned Reddit account, shared across all users.
# Set this id, then connect Reddit in Composio for that user (admin setup only).
REDDIT_SHARED_USER_ID=ripple-shared-reddit

# Public URL of this app (used to build tracked links)
APP_URL=http://localhost:3001
