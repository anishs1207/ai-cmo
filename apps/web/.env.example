# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Composio (https://app.composio.dev -> Settings -> API Keys)
COMPOSIO_API_KEY=

# One app-owned Reddit account, shared across all users.
# Connect it once from the Connections page; the id below scopes it in Composio.
REDDIT_SHARED_USER_ID=ripple-shared-reddit

# Public URL of this app (used to build tracked links)
APP_URL=http://localhost:3001
