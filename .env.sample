# ==============================================================================
# RIPPLE / BART-LABS ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=https://auth.sample.neon.tech
NEON_AUTH_COOKIE_SECRET=replace_with_32_character_secret_key_12345

# Gemini AI (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# HIGGSFIELD AI MCP SERVER & API CONFIGURATION
# ------------------------------------------------------------------------------
# Official Higgsfield MCP Server URL: https://mcp.higgsfield.ai/mcp
HIGGSFIELD_MCP_SERVER_URL=https://mcp.higgsfield.ai/mcp
# Higgsfield Cloud API Key (https://cloud.higgsfield.ai)
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here

# ------------------------------------------------------------------------------
# META (FACEBOOK & INSTAGRAM) ADS MCP SERVER & MARKETING API
# ------------------------------------------------------------------------------
# Official Meta Ads MCP Server URL: https://mcp.facebook.com/ads
META_MCP_SERVER_URL=https://mcp.facebook.com/ads
# Meta Graph API User/System User Access Token with ads_management, ads_read, instagram_basic, instagram_content_publish
META_ACCESS_TOKEN=EAAB...your_meta_access_token_here
# Meta Ad Account ID (e.g. act_1234567890)
META_AD_ACCOUNT_ID=act_123456789012345
# Meta Facebook Page ID and Instagram Business Account ID
META_PAGE_ID=100123456789012
META_INSTAGRAM_ACTOR_ID=17841400000000000

# ------------------------------------------------------------------------------
# GOOGLE ADS (YOUTUBE ADS) MCP SERVER & API
# ------------------------------------------------------------------------------
# Google Ads MCP Server URL
GOOGLE_ADS_MCP_SERVER_URL=https://mcp.googleads.googleapis.com/mcp
# Google Ads Developer Token & OAuth credentials
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token_here
GOOGLE_ADS_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your_oauth_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=123-456-7890

# ------------------------------------------------------------------------------
# COMPOSIO MANAGED PLATFORM
# ------------------------------------------------------------------------------
# Composio API Key (https://app.composio.dev -> Settings -> API Keys)
COMPOSIO_API_KEY=your_composio_api_key_here
REDDIT_SHARED_USER_ID=ripple-shared-reddit

# Public Application URL
APP_URL=http://localhost:3001
