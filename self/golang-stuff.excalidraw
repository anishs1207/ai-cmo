      "isDeleted": false,
      "boundElements": [],
      "updated": 1784294915627,
      "link": null,
      "locked": false,
      "text": "Tesseract",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Tesseract",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "WE9sjLSIrqHLEX2bE_7y0",
      "type": "text",
      "x": 727.3589751416553,
      "y": 880.0935672491933,
      "width": 232.597060434179,
      "height": 300,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a8",
      "roundness": null,
      "seed": 372833877,
      "version": 59,
      "versionNonce": 925762837,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784294811622,
      "link": null,
      "locked": false,
      "text": "Applications:\n1. Extensive support\nfor 100+ languages.\n\n2. Works well for clean,\nhigh-resolution printed\ndocuments.\n\n3. Lightweight CPU-\nonly; Deployable on\nresource-constrained\nsystems",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Applications:\n1. Extensive support for 100+ languages.\n\n2. Works well for clean, high-resolution printed documents.\n\n3. Lightweight CPU-only; Deployable on resource-constrained systems",
      "autoResize": false,
      "lineHeight": 1.25
    },
    {
      "id": "bkzE0rIR2eI8oxklJKD_M",
      "type": "text",
      "x": 1028.1709130031256,
      "y": 874.0009638270319,
      "width": 276.60455989601337,
      "height": 375,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 958934491,
      "version": 124,
      "versionNonce": 271037557,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784294926517,
      "link": null,
      "locked": false,
      "text": "Limitations:\n\nStruggles with \"text-in-the-\nwild\" scenarios:\n\n1. Cannot reliably interpret\nhandwriting or low-quality\nscans\n\n2. Performs poorly on\ncomplex or irregular layouts,\nsuch as curved text, multi-\ncolumn documents, noisy\nbackgrounds\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Limitations:\n\nStruggles with \"text-in-the-wild\" scenarios:\n\n1. Cannot reliably interpret handwriting or low-quality scans\n\n2. Performs poorly on complex or irregular layouts, such as curved text, multi-column documents, noisy backgrounds\n",
      "autoResize": false,
      "lineHeight": 1.25
    },
