    {
      "id": "giZeyVc6gHNW6I0RgfjML",
      "type": "text",
      "x": 952.2025658843667,
      "y": 823.3140376935274,
      "width": 98.83990478515625,
      "height": 25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
