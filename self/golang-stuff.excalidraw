    },
    {
      "id": "U7rF6YZn-KPFwsHnz5qwL",
      "type": "text",
      "x": 1037.642136069908,
      "y": 1573.1080111757008,
      "width": 469.33966064453125,
      "height": 125,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b13",
      "roundness": null,
      "seed": 247135990,
      "version": 224,
      "versionNonce": 557689066,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784367805453,
      "link": null,
      "locked": false,
      "text": "AgentOS Orchestrator Engine\n- prod grade k8 like orchestrator for AI Agents\n- manages agent lifecycles, handles dynamic\nhost port allocation, reverse proxies and\nload balances incoming traffic",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "AgentOS Orchestrator Engine\n- prod grade k8 like orchestrator for AI Agents\n- manages agent lifecycles, handles dynamic\nhost port allocation, reverse proxies and\nload balances incoming traffic",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VHzKVaqUEuqlPZSDZbSuP",
      "type": "text",
      "x": 1586.1836757501342,
      "y": 1415.835852885331,
      "width": 173.2998504638672,
      "height": 325,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b14",
      "roundness": null,
      "seed": 726669460,
      "version": 240,
      "versionNonce": 457575956,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1784370729295,
      "link": null,
      "locked": false,
      "text": "New API server\n- scheduler\n- job queue\n- proxy\n- secrets manager\n- event bus\n- workflow engine\n- state store\n- workflow engine\n- observability\n- registry\n- markeplace\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "New API server\n- scheduler\n- job queue\n- proxy\n- secrets manager\n- event bus\n- workflow engine\n- state store\n- workflow engine\n- observability\n- registry\n- markeplace\n",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "VWm4fQ2aFLy2y9u3ftA2J",
      "type": "rectangle",
      "x": 1567.957448876266,
      "y": 1405.2421340783715,
      "width": 211.40860173829765,
      "height": 331.72792414926334,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b15",
